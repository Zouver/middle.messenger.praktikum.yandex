{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"target": "ES6",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"types": ["mocha", "sinon"],
		"noImplicitAny": false
	},
	"include": ["src/**/*.test.ts"]
}
